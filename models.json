        "customerEmail": {
          "type": "string",
          "label": "ایمیل مراجع",
          "description": "ایمیل رزروکننده"
        },
        "serviceId": {
          "type": "objectId",
          "relationTarget": "service",
          "label": "خدمت",
          "description": "خدمت انتخاب‌شده برای نوبت"
        },
        "staffId": {
          "type": "objectId",
          "relationTarget": "staff",
          "label": "متخصص",
          "description": "متخصص ارائه‌دهنده نوبت"
        },
        "clientId": {
          "type": "objectId",
          "relationTarget": "client",
          "label": "مراجع",
          "description": "پرونده مراجع مرتبط با نوبت"
        },
        "startsAt": {
          "type": "string",
          "label": "زمان شروع",
          "description": "تاریخ و ساعت شروع نوبت (ISO)"
        },
        "endsAt": {
          "type": "string",
          "label": "زمان پایان",
          "description": "تاریخ و ساعت پایان نوبت (ISO)"
        },
        "status": {
          "type": "string",
          "label": "وضعیت نوبت",
          "description": "وضعیت فعلی نوبت",
          "enum": [
            "pending",
            "confirmed",
            "checked_in",
            "completed",
            "cancelled",
            "no_show"
          ],
          "enumLabels": {
            "pending": "در انتظار تأیید",
            "confirmed": "تأییدشده",
            "checked_in": "پذیرش‌شده",
            "completed": "انجام‌شده",
            "cancelled": "لغوشده",
            "no_show": "عدم حضور"
          },
          "default": "confirmed"
        },
        "paymentStatus": {
          "type": "string",
          "label": "وضعیت پرداخت",
          "description": "وضعیت تسویه مالی نوبت",
          "enum": [
            "unpaid",
            "deposit_paid",
            "paid",
            "refunded",
            "credit"
          ],
          "enumLabels": {
            "unpaid": "پرداخت‌نشده",
            "deposit_paid": "بیعانه پرداخت‌شده",
            "paid": "پرداخت‌شده",
            "refunded": "عودت‌شده",
            "credit": "از اعتبار بسته"
          },
          "default": "unpaid"
        },
        "price": {
          "type": "number",
          "label": "مبلغ (ریال)",
          "description": "هزینه نوبت به ریال"
        },
        "paidAmount": {
          "type": "number",
          "label": "مبلغ پرداخت‌شده",
          "description": "مبلغ دریافت‌شده تا این لحظه",
          "default": 0
        },
        "mode": {
          "type": "string",
          "label": "نوع مراجعه",
          "description": "نحوه انجام نوبت",
          "enum": [
            "in_person",
            "phone",
            "google_meet"
          ],
          "enumLabels": {
            "in_person": "حضوری",
            "phone": "تلفنی",
            "google_meet": "آنلاین"
          },
          "default": "in_person"
        },
        "source": {
          "type": "string",
          "label": "کانال ثبت",
          "description": "محل ثبت نوبت",
          "enum": [
            "web",
            "telegram",
            "miniapp",
            "phone",
            "walk_in",
            "staff"
          ],
          "enumLabels": {
            "web": "وب‌سایت",
            "telegram": "تلگرام",
            "miniapp": "مینی‌اپ",
            "phone": "تلفنی",
            "walk_in": "حضوری",
            "staff": "پنل پذیرش"
          },
          "default": "web"
        },
        "notes": {
          "type": "string",
          "label": "یادداشت مراجع",
          "description": "توضیحات ثبت‌شده هنگام رزرو"
        }
      }
    }
  },
