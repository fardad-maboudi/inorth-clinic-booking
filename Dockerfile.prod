# Multi-stage production build: Vite static assets served by nginx. In the
# cluster, use the generated-site preview image: it already contains the pinned
# pnpm binary, dependency store, and baseline node_modules.
ARG PREVIEW_IMAGE=node:20-alpine
FROM ${PREVIEW_IMAGE} AS builder

WORKDIR /app

ARG NPM_REGISTRY=
# The builder installs from package.json + lockfile BEFORE `COPY . .`, so the
# app's `.npmrc` is not present yet and cannot supply the `@joorchin` scope.
ARG JOORCHIN_NPM_REGISTRY=
# The cluster preview image already has pnpm. Keep the node:20-alpine default
# usable for standalone/local builds without paying this bootstrap cost in k8s.
RUN if ! command -v pnpm >/dev/null 2>&1; then \
      if [ -n "$NPM_REGISTRY" ]; then npm config set registry "$NPM_REGISTRY"; fi; \
      npm install --global pnpm@12.3.4; \
    fi

COPY package.json pnpm-lock.yaml* ./
# Non-frozen lockfile fails publish loudly when package.json and lock disagree.
# --ignore-scripts matches the runtime deps-install path: dependency lifecycle
# scripts never run inside this credential-carrying build context (adversarial
# audit P0-1). Verified by throwaway build 2026-08-23: install + `pnpm run
# build` complete without any lifecycle script (vite/esbuild ship binaries as
# platform packages, not postinstall downloads).
# `pnpm config` also bootstraps pnpm; prepare its registry before invoking it.
RUN if [ -n "$NPM_REGISTRY" ]; then printf 'registry=%s\n' "$NPM_REGISTRY" >> .npmrc; fi \
    && { [ -z "$JOORCHIN_NPM_REGISTRY" ] || printf '@joorchin:registry=%s\n' "$JOORCHIN_NPM_REGISTRY" >> .npmrc; } \
    && (pnpm install --offline --frozen-lockfile --ignore-scripts \
        || pnpm install --frozen-lockfile --ignore-scripts)

COPY . .

ARG VITE_BASE=/
ARG VITE_APP_ID=
# Direct Joorchin API origin for customer-hosted builds; override when the app
# uses a different Joorchin environment.
ARG VITE_JOORCHIN_SERVER_URL=https://api.joorchin.site
# Production must use the real Joorchin API unless a demo image is explicitly
# requested with --build-arg VITE_API_MODE=demo.
ARG VITE_API_MODE=live
# Public origin of the published site, e.g. https://acme.joorchin.site. The
# sitemap generator (generated-site/vite-plugin/sitemap-plugin.js) needs it
# because the sitemaps protocol requires absolute <loc> URLs; unset, the build
# emits robots.txt without a Sitemap: line and no sitemap.xml at all.
ARG VITE_SITE_URL=
ENV VITE_BASE=$VITE_BASE
ENV VITE_APP_ID=$VITE_APP_ID
ENV VITE_JOORCHIN_SERVER_URL=$VITE_JOORCHIN_SERVER_URL
ENV VITE_API_MODE=$VITE_API_MODE
ENV VITE_SITE_URL=$VITE_SITE_URL

RUN pnpm run build

FROM nginx:1.27-alpine

COPY --from=builder /app/dist /usr/share/nginx/html

# Do not add a server-level `types { }` map — nginx replaces include
# mime.types instead of merging, so index.html becomes octet-stream.
RUN printf '%s\n' \
  'server {' \
  '    listen 80;' \
  '    root /usr/share/nginx/html;' \
  '    index index.html;' \
  '    location = /sw.js {' \
  '        add_header Cache-Control "no-cache";' \
  '        try_files $uri =404;' \
  '    }' \
  '    location = /manifest.webmanifest {' \
  '        default_type application/manifest+json;' \
  '        add_header Cache-Control "no-cache";' \
  '        try_files $uri =404;' \
  '    }' \
  '    location /assets/ {' \
  '        add_header Cache-Control "public, max-age=31536000, immutable";' \
  '        try_files $uri =404;' \
  '    }' \
  '    location = /index.html {' \
  '        add_header Cache-Control "no-cache";' \
  '    }' \
  '    location = /miniapp/index.html {' \
  '        add_header Cache-Control "no-cache";' \
  '    }' \
  '    location /miniapp/ {' \
  '        try_files $uri $uri/ /miniapp/index.html;' \
  '    }' \
  '    location / {' \
  '        try_files $uri $uri/ /index.html;' \
  '    }' \
  '}' \
  > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
