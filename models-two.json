[
  {
    "name": "hero_slide",
    "schemaDefinition": {
      "label": "اسلایدهای بنر اصلی",
      "description": "تصاویر، متن‌ها و دکمه‌های اسلایدر صفحه اصلی کلینیک",
      "required": [
        "title",
        "image"
      ],
      "properties": {
        "slideKey": {
          "type": "string",
